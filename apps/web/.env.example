# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="postgresql://opencut:opencut@localhost:5432/opencut"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# Optional LAN token for native HyperFrames and project sync (>=16 chars)
OPENCUT_LAN_SYNC_TOKEN=replace-with-random-lan-secret-at-least-16-chars
# LAN IP or DNS name used to reach the Docker host (for Caddy's local TLS certificate)
OPENCUT_LAN_HOST=192.168.1.10
# Optional automation command TTL in milliseconds (default: 24 hours; 1 hour to 7 days)
AUTOMATION_COMMAND_TTL_MS=86400000
# The embedded HyperFrames fallback is bundled in Docker (no Ollama required).
# It uses about 0.9 GiB RAM while generating; leave these defaults unchanged.
LOCAL_AI_BASE_URL=http://local-ai:8080/v1
LOCAL_AI_MODEL=qwen2.5-coder-0.5b-instruct-q4_k_m.gguf
# Optional storage policy (defaults: 16 GiB/asset, 64 GiB/project, 120 snapshots)
LAN_SYNC_MAX_ASSET_BYTES=17179869184
LAN_SYNC_MAX_PROJECT_BYTES=68719476736
LAN_SYNC_MAX_CHECKPOINTS=120
# Only when using the optional local Parakeet speech service
PARAKEET_INTERNAL_TOKEN=replace-with-third-random-worker-secret

# Optional web importer. Enable it with: docker compose --profile importer up -d importer
# It uses yt-dlp through its own web UI and does not require a third-party API key.
# Set a password whenever the Cut Editor is reachable by other devices on the LAN.
IMPORTER_PASSWORD=replace-with-a-strong-importer-password
# Optional comma-separated supported hosts. Leave empty for the downloader's defaults.
IMPORTER_ALLOWED_SITES=
IMPORTER_MAX_CONCURRENT_JOBS=1
IMPORTER_MAX_FILESIZE_MB=2048
IMPORTER_MAX_DURATION_MINUTES=180
